[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%ManufacturerName%
DriverVer=1.0
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksFiles]
lesser-joy-driver.sys = 1

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName%=Standard,NT64

[Standard.NT$ARCH$]
%lesser-joy.ProCon2.DeviceDesc%=lesser-joy-device, TapzCrew\Switch2\ProController

[strings]
ManufacturerName="TapzCrew"
DiskName = "lesser-joy Installation Disk"
lesser-joy.ProCon2.DeviceDesc = "lesser-joy Switch Pro Controller 2"
